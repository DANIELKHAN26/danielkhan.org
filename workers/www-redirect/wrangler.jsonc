// Sends www.danielkhan.org (http or https, any path) to https://danielkhan.org with a permanent redirect.
{
  "name": "danielkhan-org-www-redirect",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "www.danielkhan.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false
}
