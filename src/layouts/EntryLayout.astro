---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { formatDate, isoDate, isExternal } from '../lib/content';
import { githubCommunityUrl } from '../site.config';

interface Props {
  title: string;
  summary: string;
  section: { label: string; href: string };
  kicker: string;
  date: Date;
  updated?: Date;
  status?: string;
  tags?: string[];
  minutes?: number;
  cover?: ImageMetadata;
  coverAlt?: string;
  draft?: boolean;
  ogType?: 'website' | 'article';
}

const {
  title, summary, section, kicker, date, updated, status, tags = [], minutes,
  cover, coverAlt, draft = false, ogType = 'article',
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const correctionUrl = githubCommunityUrl
  ? `${githubCommunityUrl}/issues/new?template=correction.yml&page=${encodeURIComponent(pageUrl)}`
  : '/collaborate/';
---

<BaseLayout title={title} description={summary} ogType={ogType} published={date} noindex={draft} searchable>
  <article>
    <header class="page-head">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
          <a href="/">Home</a><span aria-hidden="true">/</span><a href={section.href}>{section.label}</a>
        </nav>
        {draft && <p class="draft-flag" role="note">Draft — only visible in local preview. Set <code>draft: false</code> to publish.</p>}
        <h1>{title}</h1>
        <p>{summary}</p>
        <div class="entry-meta" data-pagefind-ignore>
          <span>{kicker}</span>
          {status && <StatusBadge status={status} />}
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          {updated && <span>Updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time></span>}
          {minutes && <span>{minutes} min read</span>}
        </div>
      </div>
    </header>

    <div class="container entry-body">
      {cover && coverAlt && (
        <Image class="entry-cover" src={cover} alt={coverAlt} widths={[640, 960, 1280]} sizes="(min-width: 46rem) 40rem, 100vw" />
      )}
      <slot name="use" />
      <div class="prose">
        <slot />
      </div>

      <footer class="entry-foot" data-pagefind-ignore>
        <slot name="actions" />
        {tags.length > 0 && <ul class="tags" aria-label="Topics">{tags.map((t) => <li>{t}</li>)}</ul>}
        <p class="entry-small no-print">
          <button type="button" class="copy-link" data-url={pageUrl}>Copy link</button>
          <span class="copy-status" role="status"></span>
          <span aria-hidden="true">·</span>
          <a href={correctionUrl} rel={isExternal(correctionUrl) ? 'noopener' : undefined}>Suggest a correction</a>
        </p>
      </footer>
    </div>
  </article>
  <slot name="after" />
</BaseLayout>

<style>
  .draft-flag { background: #fff3d6; color: #5a3d00; border: 1px solid #e9c46a; padding: 0.6rem 0.9rem; border-radius: var(--radius-sm); margin-bottom: 1.25rem; font-size: 0.95rem; }
  .entry-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem; margin-top: 1.25rem; font-size: var(--text-sm); color: var(--ink-faint); }
  .entry-body { padding-block: 2.25rem var(--space-section); }
  .entry-body :global(.entry-cover) { width: 100%; max-width: var(--measure); border-radius: var(--radius); margin-bottom: 2rem; }
  .entry-foot { max-width: var(--measure); margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); display: grid; gap: 1.25rem; }
  .entry-small { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: var(--text-sm); color: var(--ink-faint); }
  .entry-small a { color: var(--ink-soft); }
  .copy-link { border: 0; background: none; padding: 0; color: var(--ink-soft); text-decoration: underline; cursor: pointer; font-size: inherit; min-height: 1.5rem; }
  .copy-link:hover, .entry-small a:hover { color: var(--sea); }
  .copy-status:empty { display: none; }
</style>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.copy-link')) {
    const status = btn.parentElement?.querySelector('.copy-status');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.url ?? location.href);
        if (status) status.textContent = 'Link copied';
      } catch {
        if (status) status.textContent = 'Copy failed — use the address bar';
      }
    });
  }
</script>
