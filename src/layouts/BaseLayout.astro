---
import { Font, getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, socialLinks } from '../site.config';
import { PROFILE } from '../data/profile';
import ogDefault from '../assets/og-card.png';
import portraitPhoto from '../assets/daniel-khan-profile.jpg';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 'article' for writing and log entries. */
  ogType?: 'website' | 'article';
  published?: Date;
  /** Exclude a page from search engines. */
  noindex?: boolean;
  /** Include this page's main content in the site search (listing pages leave it off). */
  searchable?: boolean;
  /** Structured data for search engines: 'home' = WebSite + Person; 'profile' = ProfilePage (About). */
  schema?: 'home' | 'profile';
}

const { title, description = SITE.description, ogType = 'website', published, noindex = false, searchable = false, schema } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.role}, ${SITE.affiliation}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogDefault.src, Astro.site);

// Google: use the person's real photo (never a placeholder) and only facts shown on the site.
const photo = await getImage({ src: portraitPhoto, width: 640, format: 'jpg' });
const person = {
  '@type': 'Person',
  name: SITE.name,
  url: `${SITE.url}/`,
  image: new URL(photo.src, Astro.site).href,
  jobTitle: SITE.role,
  affiliation: { '@type': 'CollegeOrUniversity', name: SITE.affiliation },
  alumniOf: PROFILE.education.slice(1).map((e) => ({ '@type': 'CollegeOrUniversity', name: e.institution.split(',')[0] })),
  knowsAbout: PROFILE.interests,
  description: SITE.description,
  sameAs: socialLinks.map((s) => s.url),
};
// ProfilePage belongs on the About page (Google lists general home pages as invalid for it);
// WebSite on the home page declares the site name.
const structuredData = schema === 'home'
  ? [
      { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, alternateName: 'danielkhan.org', url: `${SITE.url}/` },
      { '@context': 'https://schema.org', ...person },
    ]
  : schema === 'profile'
    ? [{ '@context': 'https://schema.org', '@type': 'ProfilePage', url: canonical.href, mainEntity: person }]
    : [];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f6f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#071820" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — research, projects and updates`} href="/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.role}, ${SITE.affiliation}`} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Preload the headline font only (prevents layout shift); body text uses size-matched fallbacks until its font arrives. -->
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-serif" />

    <slot name="head" />
    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <!-- Apply the saved theme before first paint so the page never flashes. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" data-pagefind-body={searchable && !noindex ? '' : undefined}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
