---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Page not found" noindex>
  <PageHeader title="Page not found" lede="This page may have moved, or the link may be incomplete.">
    <div class="actions">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-ghost" href="/research/">Research</a>
      <a class="btn btn-ghost" href="/search/">Search</a>
    </div>
  </PageHeader>
</BaseLayout>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
</style>
