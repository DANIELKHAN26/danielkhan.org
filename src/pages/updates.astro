---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PodcastTeaser from '../components/PodcastTeaser.astro';
import UpdateCard from '../components/UpdateCard.astro';
import Icon from '../components/Icon.astro';
import { getUpdates, getLog, formatDate, isoDate } from '../lib/content';
import { PLATFORMS, type Platform } from '../content.config';
import { socialLinks } from '../site.config';

const updates = await getUpdates();
const episodes = updates.filter((u) => u.data.podcast);
const posts = updates.filter((u) => !u.data.podcast);
const platformsWithPosts = (Object.keys(PLATFORMS) as Platform[]).filter((p) => posts.some((u) => u.data.platform === p));
const notes = await getLog();
---

<BaseLayout searchable title="Updates" description="Daniel Khan's writing, videos and posts from Substack, YouTube, LinkedIn and Facebook — plus the podcast, coming soon.">
  <PageHeader title="Updates" lede="Writing, videos and posts from across my channels, collected in one place." />

  <div class="container updates">
    <section class="block" aria-labelledby="channels-title">
      <h2 id="channels-title" class="visually-hidden">Channels</h2>
      <ul class="channels">
        {socialLinks.map((s) => (
          <li>
            <a class="channel" href={s.url} rel="me noopener">
              <Icon name={s.icon} size={22} />
              <span class="channel-text">
                <span class="channel-name">{s.label}</span>
                <span class="channel-about">{s.about}</span>
              </span>
              <span class="channel-go" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="block" id="podcast" aria-labelledby="podcast-title">
      <PodcastTeaser />
      {episodes.length > 0 && (
        <div class="grid episodes">{episodes.map((e) => <UpdateCard entry={e} />)}</div>
      )}
    </section>

    {posts.length > 0 && (
      <section class="block" id="latest" aria-labelledby="latest-title">
        <div class="latest-head">
          <h2 id="latest-title">Latest posts</h2>
          {platformsWithPosts.length > 1 && (
            <div class="filters" role="group" aria-label="Filter by platform" hidden>
              <button class="chip" type="button" data-filter="all" aria-pressed="true">All</button>
              {platformsWithPosts.map((p) => <button class="chip" type="button" data-filter={p} aria-pressed="false">{PLATFORMS[p].label}</button>)}
            </div>
          )}
        </div>
        <div class="grid" id="post-grid">
          {posts.map((u) => <div class="cell" data-platform={u.data.platform}><UpdateCard entry={u} /></div>)}
        </div>
      </section>
    )}

    {notes.length > 0 && (
      <section class="block" id="notes" aria-labelledby="notes-title">
        <h2 id="notes-title">Notes from this site</h2>
        <ul class="notes">
          {notes.map((n) => (
            <li>
              <a href={`/log/${n.id}/`}>{n.data.title}{n.data.draft && ' (draft)'}</a>
              <time datetime={isoDate(n.data.date)}>{formatDate(n.data.date)}</time>
            </li>
          ))}
        </ul>
        <p class="rss">Follow everything by <a href="/rss.xml">RSS</a>.</p>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .updates { padding-bottom: var(--space-section); }
  .block { padding-top: clamp(1.75rem, 1.25rem + 2vw, 2.75rem); }
  .block h2:not(.visually-hidden) { font-size: var(--h2); }

  .channels { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: 0.75rem; }
  .channel { display: flex; align-items: center; gap: 0.8rem; height: 100%; padding: 0.9rem 1rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); text-decoration: none; transition: border-color .2s; }
  .channel:hover { border-color: var(--sea); }
  .channel-text { display: grid; gap: 0.1rem; min-width: 0; }
  .channel-name { font-weight: 700; }
  .channel-about { font-size: 0.88rem; color: var(--ink-soft); }
  .channel-go { margin-left: auto; color: var(--sea); }

  .latest-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1.5rem; margin-bottom: 1rem; }
  .filters { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip { min-height: 2.25rem; padding: 0.3rem 0.85rem; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); font-size: 0.88rem; font-weight: 600; cursor: pointer; }
  .chip[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: 1rem; }
  .episodes { margin-top: 1rem; }
  .cell { display: grid; }
  .cell[hidden] { display: none; }

  .notes { list-style: none; padding: 0; margin-top: 0.75rem; border-top: 1px solid var(--line); }
  .notes li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1.5rem; padding-block: 0.75rem; border-bottom: 1px solid var(--line); }
  .notes a { font-weight: 600; text-decoration: none; }
  .notes a:hover { color: var(--sea); text-decoration: underline; }
  .notes time { font-size: var(--text-sm); color: var(--ink-faint); }
  .rss { margin-top: 1rem; font-size: var(--text-sm); color: var(--ink-faint); }
  .rss a { color: var(--sea); }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('.filters');
  const cells = [...document.querySelectorAll<HTMLElement>('#post-grid .cell')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.filters .chip')];
  if (bar && cells.length) {
    bar.hidden = false;
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const f = chip.dataset.filter ?? 'all';
        for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
        for (const cell of cells) cell.hidden = f !== 'all' && cell.dataset.platform !== f;
      });
    }
  }
</script>
