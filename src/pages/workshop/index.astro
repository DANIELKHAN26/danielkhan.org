---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { getWorkshop } from '../../lib/content';
import { githubCommunityUrl } from '../../site.config';

const items = await getWorkshop();
---

<BaseLayout title="Workshop" description="Free templates, tools and designs by Daniel Khan — licensed for reuse, with credit for any work they build on.">
  <PageHeader title="Workshop" lede="Templates, tools and designs I've made or adapted, free for anyone to use. Each one states its licence and credits." />
  <section class="section">
    <div class="container">
      {items.length > 0
        ? <div class="cards">{items.map((entry) => <ResourceCard entry={entry} headingLevel="h2" />)}</div>
        : <p>The first resources are being prepared.</p>}
      <p class="how">
        Found a problem or made something with these?{' '}
        {githubCommunityUrl ? <a href={githubCommunityUrl}>Share it in the collaboration space</a> : <a href="/collaborate/">Tell me</a>}.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .how { margin-top: 2rem; color: var(--ink-soft); }
  .how a { color: var(--sea); }
</style>
