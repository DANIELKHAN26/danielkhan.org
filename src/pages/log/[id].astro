---
import { render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getLog, readingMinutes, isExternal } from '../../lib/content';

export async function getStaticPaths() {
  const log = await getLog();
  return log.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<EntryLayout
  title={data.title}
  summary={data.summary}
  section={{ label: 'Updates', href: '/updates/#notes' }}
  kicker="Note"
  date={data.date}
  updated={data.updated}
  tags={data.tags}
  minutes={readingMinutes(entry.body)}
  draft={data.draft}
>
  <Content />

  <Fragment slot="actions">
    {data.links.length > 0 && (
      <div class="links">
        {data.links.map((l) => (
          <a class="btn btn-ghost" href={l.url} rel={isExternal(l.url) ? 'noopener' : undefined}>{l.label} <span aria-hidden="true">↗</span></a>
        ))}
      </div>
    )}
  </Fragment>
</EntryLayout>

<style>
  .links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
