---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Annal from '../../components/Annal.astro';
import { getLog } from '../../lib/content';

const log = await getLog();
---

<BaseLayout title="Updates" description="Dated updates from Daniel Khan: releases, project progress and notes.">
  <PageHeader title="Updates" lede="Releases, progress and notes, newest first. Follow along by RSS.">
    <p class="rss"><a href="/rss.xml">RSS feed</a></p>
  </PageHeader>
  <section class="section">
    <div class="container">
      {log.length > 0 ? <Annal entries={log} /> : <p>The first update is on its way.</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .rss a { font-weight: 600; }
</style>
