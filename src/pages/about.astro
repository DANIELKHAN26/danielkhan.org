---
import BaseLayout from '../layouts/BaseLayout.astro';
import Portrait from '../components/Portrait.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { PROFILE } from '../data/profile';
import { SITE } from '../site.config';
---

<BaseLayout searchable title="About" description={`About ${SITE.name}, ${SITE.role} at ${SITE.affiliation}: education, experience and research interests.`}>
  <header class="page-head">
    <div class="container about-head">
      <Portrait size="small" eager />
      <div>
        <h1>About</h1>
        <p class="about-role">{SITE.role}, {SITE.affiliation}</p>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container about-grid">
      <div class="prose about-bio">
        {PROFILE.bio.map((p) => <p>{p}</p>)}
      </div>

      <dl class="facts">
        <div class="fact">
          <dt>Education</dt>
          <dd>
            <ul>
              {PROFILE.education.map((e) => (
                <li><strong>{e.award}</strong>{' '}<span>{e.institution}{e.years && <>, <span class="nowrap">{e.years}</span></>}</span></li>
              ))}
            </ul>
          </dd>
        </div>
        <div class="fact">
          <dt>Selected experience</dt>
          <dd>
            <ul>
              {PROFILE.experience.map((x) => (
                <li><strong>{x.role}</strong>{' '}<span>{x.organisation}, <span class="nowrap">{x.years}</span></span></li>
              ))}
            </ul>
          </dd>
        </div>
        <div class="fact">
          <dt>Research interests</dt>
          <dd><ul class="tags">{PROFILE.interests.map((i) => <li>{i}</li>)}</ul></dd>
        </div>
        <div class="fact">
          <dt>Methods and tools</dt>
          <dd><ul class="tags">{PROFILE.methods.map((m) => <li>{m}</li>)}</ul></dd>
        </div>
        <div class="fact">
          <dt>Elsewhere</dt>
          <dd><SocialLinks variant="list" /></dd>
        </div>
        <div class="fact">
          <dt>CV</dt>
          <dd>{PROFILE.cv
            ? <p><a href={PROFILE.cv}>Download CV (PDF)</a></p>
            : <p>A full CV is available on request — <a href="/collaborate/">get in touch</a>.</p>}</dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .about-head { display: flex; align-items: center; gap: 1.25rem; }
  .about-role { margin-top: 0.4rem; color: var(--sea); font-weight: 600; font-size: var(--text-lg); }
  .about-grid { display: grid; gap: 2.5rem; }
  .facts { display: grid; gap: 0; border-top: 1px solid var(--line); max-width: 52rem; }
  .fact { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 0.5rem 2rem; padding-block: 1.15rem; border-bottom: 1px solid var(--line); }
  .fact dt { font-weight: 700; }
  .fact dd { margin: 0; }
  .fact ul:not(.tags):not(.social) { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .fact li strong { display: block; font-weight: 600; }
  .fact li span { color: var(--ink-soft); }
  .fact p a { color: var(--sea); }
  .nowrap { white-space: nowrap; }
  @media (max-width: 40rem) { .fact { grid-template-columns: 1fr; } }
</style>
