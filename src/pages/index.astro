---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkRow from '../components/WorkRow.astro';
import ResourceCard from '../components/ResourceCard.astro';
import Annal from '../components/Annal.astro';
import { getWork, getWorkshop, getLog, joinProjectUrl } from '../lib/content';
import { SITE, githubCommunityUrl } from '../site.config';
import portrait from '../assets/daniel-khan-beach.jpg';
import headshot from '../assets/daniel-khan-headshot.jpg';

const work = await getWork();
const featured = (work.some((w) => w.data.featured) ? work.filter((w) => w.data.featured) : work).slice(0, 5);
const resources = (await getWorkshop()).slice(0, 3);
const log = (await getLog()).slice(0, 4);
const openProjects = work.filter((w) => w.data.collaboration?.open);

const practice = [
  { type: 'research', name: 'Research', text: 'Public-interest questions, especially in Bangladesh, traced back to the record.' },
  { type: 'writing', name: 'Writing', text: 'Essays and explainers that say what the evidence shows — and where it stops.' },
  { type: 'media', name: 'Documentary', text: 'Scripts and presenting, built to be understood on first hearing.' },
  { type: 'project', name: 'Projects', text: 'Larger independent work, from news formats to community platforms.' },
];
// Link each area to its filtered list, or to all work while an area has nothing published yet.
const hrefFor = (type: string) => (work.some((w) => w.data.type === type) ? `/work/?type=${type}` : '/work/');
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <Picture
      src={portrait}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1600, 2048]}
      sizes="(max-width: 52rem) 170vh, 100vw"
      alt="Daniel Khan on a pebble beach on a windy, bright day, with breaking waves and open blue sky behind him"
      class="hero-img"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-content">
      <p class="hero-eyebrow">Daniel Khan <span aria-hidden="true">—</span> {SITE.roles.join(' · ')}</p>
      <h1 id="hero-title" class="display">
        <span class="line">Good questions</span>{' '}
        <span class="line">deserve a</span>{' '}
        <span class="line">full answer.</span>
      </h1>
      <div class="hero-actions">
        <a class="btn btn-light" href="/work/">See the work <span class="arrow" aria-hidden="true">↗</span></a>
        <a class="btn btn-outline-light" href="/workshop/">Free tools &amp; templates</a>
      </div>
    </div>
  </section>

  <section class="section intro" aria-labelledby="intro-title">
    <div class="wrap intro-grid">
      <div>
        <div class="intro-byline">
          <Picture src={headshot} formats={['avif', 'webp']} widths={[96, 192]} sizes="96px" alt="Daniel Khan" class="avatar" />
          <p class="eyebrow">What I do</p>
        </div>
        <h2 id="intro-title" class="intro-text">{SITE.intro}</h2>
      </div>
      <ul class="practice">
        {practice.map((p) => (
          <li>
            <a href={hrefFor(p.type)}>
              <span class="practice-name">{p.name}<span class="practice-arrow" aria-hidden="true">→</span></span>
              <span class="practice-text">{p.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section" aria-labelledby="work-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Selected work</p>
            <h2 id="work-title" class="display">On the desk</h2>
            <p>Each entry says plainly whether it is a concept, in development or published.</p>
          </div>
          <a class="text-link" href="/work/">All work <span aria-hidden="true">→</span></a>
        </div>
        <ul class="ledger">{featured.map((entry) => <WorkRow entry={entry} />)}</ul>
      </div>
    </section>
  )}

  {resources.length > 0 && (
    <section class="section workshop-band" aria-labelledby="workshop-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Open workshop</p>
            <h2 id="workshop-title" class="display">Free to use. Free to improve.</h2>
            <p>Templates, tools and designs I've made or adapted — each with a licence, a version and credit for anyone whose work it builds on.</p>
          </div>
          <a class="text-link" href="/workshop/">Everything in the workshop <span aria-hidden="true">→</span></a>
        </div>
        <div class="card-grid">{resources.map((entry) => <ResourceCard entry={entry} />)}</div>
      </div>
    </section>
  )}

  {log.length > 0 && (
    <section class="section" aria-labelledby="log-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Log</p>
            <h2 id="log-title" class="display">The running record</h2>
            <p>What I made, changed and learned — in date order.</p>
          </div>
          <a class="text-link" href="/log/">Full log <span aria-hidden="true">→</span></a>
        </div>
        <Annal entries={log} yearHeading="h3" />
      </div>
    </section>
  )}

  <section class="collab-band" aria-labelledby="collab-title">
    <div class="wrap collab-grid">
      <div>
        <p class="eyebrow eyebrow-light">Collaborate</p>
        <h2 id="collab-title" class="display">Some questions need more than one person.</h2>
        <p class="collab-copy">Researchers, designers, developers, translators and anyone with a well-sourced correction are welcome. Join a project below, start a public discussion, or send a private note.</p>
        <div class="collab-actions">
          <a class="btn btn-light" href="/collaborate/">Ways to collaborate <span class="arrow" aria-hidden="true">↗</span></a>
          {githubCommunityUrl && <a class="btn btn-outline-light" href={`${githubCommunityUrl}/discussions`}>Start a discussion</a>}
        </div>
      </div>
      {openProjects.length > 0 && (
        <div class="open-projects">
          <p class="open-label mono">Looking for help now</p>
          <ul>
            {openProjects.map((p) => (
              <li>
                <a href={`/work/${p.id}/`} class="open-title">{p.data.title}</a>
                {p.data.collaboration?.needs.length ? <span>{p.data.collaboration.needs.join(' · ')}</span> : null}
                <a class="open-join" href={joinProjectUrl(githubCommunityUrl, p.data.title)}>Offer to help <span aria-hidden="true">→</span></a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* ----- Hero: the headline sits in the sky of the photograph ----- */
  .hero { position: relative; min-height: clamp(34rem, 86svh, 54rem); display: flex; color: #fff; overflow: hidden; background: #2f6fbe; }
  .hero :global(.hero-img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 78%;
    animation: settle 2.2s cubic-bezier(.2,.7,.2,1) both;
  }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(7 33 56 / 42%) 0%, rgb(7 33 56 / 12%) 42%, rgb(7 33 56 / 0%) 60%); }
  .hero-content { position: relative; display: grid; align-content: start; justify-items: end; padding-block: clamp(3rem, 9vh, 6.5rem) 3rem; }
  .hero-content > * { width: min(100%, 38rem); }
  .hero-eyebrow { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.92; }
  .hero h1 { font-size: clamp(3rem, 1.2rem + 6.6vw, 7.4rem); margin-block: 1.25rem 2rem; text-shadow: 0 2px 30px rgb(7 33 56 / 25%); }
  .hero h1 .line { display: block; animation: rise .9s cubic-bezier(.2,.7,.2,1) both; }
  .hero h1 .line:nth-child(2) { animation-delay: .12s; }
  .hero h1 .line:nth-child(3) { animation-delay: .24s; font-family: var(--font-serif); font-style: italic; font-weight: 500; font-stretch: normal; letter-spacing: -0.03em; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; animation: rise .9s .38s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(0.6em); } to { opacity: 1; transform: none; } }
  @keyframes settle { from { transform: scale(1.06); } to { transform: none; } }

  @media (max-width: 52rem) {
    .hero { min-height: clamp(36rem, 92svh, 48rem); }
    .hero :global(.hero-img) { object-position: 21% 100%; }
    .hero-content { justify-items: start; padding-top: 2.5rem; }
    .hero h1 { font-size: clamp(2.9rem, 12.5vw, 4.6rem); margin-block: 0.9rem 1.5rem; }
    .hero-shade { background: linear-gradient(180deg, rgb(7 33 56 / 50%) 0%, rgb(7 33 56 / 18%) 45%, rgb(7 33 56 / 0%) 62%); }
  }

  /* ----- Intro ----- */
  .intro-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .intro-byline { display: flex; align-items: center; gap: 1rem; }
  .intro-byline :global(.avatar) { width: 4.5rem; height: 4.5rem; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 3px var(--paper), 0 0 0 5px var(--sea); }
  .intro-text { font-family: var(--font-serif); font-weight: 400; font-size: var(--step-3); line-height: 1.2; letter-spacing: -0.015em; margin-top: 1.25rem; }
  .practice { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .practice li { border-bottom: 1px solid var(--line); }
  .practice a { display: grid; gap: 0.3rem; padding: 1.1rem 0; text-decoration: none; }
  .practice-name { display: flex; justify-content: space-between; align-items: baseline; font-weight: 650; font-size: var(--step-1); font-stretch: 88%; }
  .practice-arrow { color: var(--sea); transition: transform .2s; }
  .practice a:hover .practice-arrow { transform: translateX(4px); }
  .practice-text { color: var(--ink-soft); font-family: var(--font-serif); }
  .practice a:hover .practice-name { color: var(--sea); }
  @media (max-width: 52rem) { .intro-grid { grid-template-columns: 1fr; } }

  .section-head h2 { max-width: 16ch; }
  .workshop-band { background: var(--sunk); }

  /* ----- Collaborate band ----- */
  .collab-band { background: var(--sea); color: var(--on-sea); padding-block: clamp(4rem, 9vw, 7rem); margin-bottom: calc(-1 * clamp(4rem, 10vw, 7rem)); }
  .collab-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .collab-band h2 { font-size: var(--step-4); margin-block: 1rem 1.25rem; max-width: 14ch; }
  .eyebrow-light { color: inherit; opacity: 0.85; }
  .collab-copy { font-family: var(--font-serif); font-size: var(--step-1); max-width: 34rem; opacity: 0.95; }
  .collab-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .collab-band .btn-outline-light { color: var(--on-sea); border-color: color-mix(in srgb, var(--on-sea) 50%, transparent); background: transparent; }
  .open-projects { background: color-mix(in srgb, var(--on-sea) 10%, transparent); border-radius: var(--radius); padding: 1.5rem; }
  .open-label { text-transform: uppercase; letter-spacing: 0.1em; opacity: 0.85; margin-bottom: 0.5rem; }
  .open-projects ul { list-style: none; margin: 0; padding: 0; }
  .open-projects li { display: grid; gap: 0.25rem; padding-block: 1rem; border-bottom: 1px solid color-mix(in srgb, var(--on-sea) 22%, transparent); }
  .open-projects li:last-child { border-bottom: 0; }
  .open-title { font-weight: 650; font-size: var(--step-1); font-stretch: 88%; text-decoration: none; }
  .open-title:hover { text-decoration: underline; }
  .open-projects span { font-size: 0.92rem; opacity: 0.88; }
  .open-join { font-weight: 600; font-size: 0.95rem; color: inherit; }
  @media (max-width: 52rem) { .collab-grid { grid-template-columns: 1fr; } }
</style>
