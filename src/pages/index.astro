---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import photo from '../assets/daniel-khan-profile.jpg';
import { PORTRAIT } from '../lib/portrait';
import Portrait from '../components/Portrait.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ResearchList from '../components/ResearchList.astro';
import WorkRow from '../components/WorkRow.astro';
import PodcastTeaser from '../components/PodcastTeaser.astro';
import { getWork, getWorkshop, getResearch } from '../lib/content';
import { SITE } from '../site.config';

const research = (await getResearch()).filter((r) => r.data.kind === 'under-review').slice(0, 3);
const work = await getWork();
const projects = [...work.filter((w) => w.data.featured), ...work.filter((w) => !w.data.featured)].slice(0, 4);
const resources = await getWorkshop();
// Start downloading the portrait (the largest element on screen) before the browser reaches it.
const heroImage = await getImage({ src: photo, format: 'avif', widths: [...PORTRAIT.widths] });
---

<BaseLayout searchable>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={heroImage.srcSet.attribute} imagesizes={PORTRAIT.sizes} fetchpriority="high" />
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-text">
      <h1 id="hero-title">{SITE.name}</h1>
      <p class="hero-role">{SITE.role}, <span class="nowrap">{SITE.affiliation}</span></p>
      <p class="hero-focus">{SITE.focus}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/research/">View research</a>
        <a class="btn btn-ghost" href="/collaborate/">Get in touch</a>
      </div>
      <SocialLinks />
    </div>
    <div class="hero-portrait">
      <Portrait eager />
    </div>
  </section>

  {research.length > 0 && (
    <section class="section" aria-labelledby="research-title">
      <div class="container">
        <div class="section-title">
          <h2 id="research-title">Current research</h2>
          <a class="link-arrow" href="/research/">All research →</a>
        </div>
        <ResearchList items={research} />
      </div>
    </section>
  )}

  {projects.length > 0 && (
    <section class="section" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-title">
          <h2 id="projects-title">Projects</h2>
          <a class="link-arrow" href="/work/">All projects →</a>
        </div>
        <ul class="rows">{projects.map((entry) => <WorkRow entry={entry} />)}</ul>
      </div>
    </section>
  )}

  <PodcastTeaser more />

  {resources.length > 0 && (
    <section class="section" aria-labelledby="workshop-title">
      <div class="container workshop-strip">
        <div>
          <h2 id="workshop-title">Open workshop</h2>
          <p>{resources.length} free templates and tools — research ledgers, production checklists and this site's own code — each with a licence and credits.</p>
        </div>
        <a class="btn btn-ghost" href="/workshop/">Browse the workshop</a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 5rem);
    align-items: center; padding-block: clamp(2.5rem, 1.5rem + 5vw, 5.5rem);
  }
  .hero h1 { font-size: var(--display); letter-spacing: -0.03em; line-height: 1.02; }
  .hero-role { margin-top: 0.9rem; font-size: var(--text-lg); font-weight: 600; color: var(--sea); }
  .hero-focus { margin-top: 1rem; max-width: 34rem; font-size: clamp(1.125rem, 1.05rem + 0.45vw, 1.35rem); line-height: 1.5; color: var(--ink-soft); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-block: 1.75rem 1.5rem; }
  .hero-portrait { display: grid; justify-items: end; }
  .nowrap { white-space: nowrap; }

  .workshop-strip {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2rem;
    padding: clamp(1.5rem, 3vw, 2rem); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface);
  }
  .workshop-strip h2 { font-size: var(--h2); }
  .workshop-strip p { margin-top: 0.5rem; color: var(--ink-soft); max-width: 40rem; }

  @media (max-width: 52rem) {
    .hero { grid-template-columns: 1fr; padding-top: 2rem; }
    .hero-portrait { order: -1; justify-items: start; }
    .hero-portrait :global(.portrait-large) { width: min(62vw, 15rem); }
  }
</style>
