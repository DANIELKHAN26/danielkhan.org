---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../site.config';

const hasForm = SITE.contact.web3formsAccessKey.length > 0;
---

<BaseLayout searchable title="Privacy and editorial policy" description="How this site handles your data, messages, corrections and licences.">
  <PageHeader title="Privacy and editorial policy" lede="No cookies, no ads, no cross-site tracking. Messages are used only to reply." />
  <div class="container policy">
    <div class="prose">
      <h2>Browsing</h2>
      <p>This is a static website served by Cloudflare. It sets no cookies and loads no advertising or third-party fonts. If you choose a light or dark theme, that preference is stored in your own browser only. Cloudflare, as the host, processes standard connection data (such as IP addresses) to deliver and protect the site; see the <a href="https://www.cloudflare.com/privacypolicy/">Cloudflare Privacy Policy</a>.</p>
      <h2>Visitor statistics</h2>
      <p>To see which pages are read, the site uses <a href="https://www.cloudflare.com/web-analytics/">Cloudflare Web Analytics</a>. It counts page views without cookies, without storing personal data in your browser, and without following you across other websites.</p>
      <h2>Videos and posts from other sites</h2>
      <p>Preview images for posts on the Updates page are stored on this site, so viewing them sends nothing to Substack, YouTube, LinkedIn or Facebook. A YouTube video loads only when you press play, using YouTube's privacy-enhanced mode (youtube-nocookie.com); from then on, YouTube's <a href="https://policies.google.com/privacy">privacy policy</a> applies. Links to other sites take you to services with their own policies.</p>
      <h2>Messages</h2>
      <p>If you email me, your message and address are used only to reply to you.{hasForm && ' If you use the contact form, your name, email and message are delivered to me through Web3Forms, a third-party form service, for the same purpose.'} Please don't send passwords, confidential documents or information about research participants.</p>
      <h2>Public discussions</h2>
      <p>The collaboration links open GitHub Discussions and Issues. Anything posted there is public and governed by GitHub's terms.</p>
      <h2>Corrections</h2>
      <p>Every project and Lab entry shows its status and date. If you find an error, use the “Suggest a correction” link on the page. Material corrections are made openly and noted on the page with the date.</p>
      <h2>Licences</h2>
      <p>Writing, photographs and media on this site are © Daniel Khan unless stated otherwise. Each Lab tool and template states its own licence, and credits any work it adapts.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .policy { padding-block: 2.25rem var(--space-section); }
  .policy .prose > :global(h2:first-child) { margin-top: 0; }
</style>
