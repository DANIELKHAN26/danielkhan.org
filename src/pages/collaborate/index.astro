---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getWork, joinProjectUrl } from '../../lib/content';
import { SITE, githubCommunityUrl, socialLinks } from '../../site.config';

const work = await getWork();
const open = work.filter((w) => w.data.collaboration?.open);
const projects = work.filter((w) => w.data.type !== 'writing');
const { email, web3formsAccessKey } = SITE.contact;
const hasForm = web3formsAccessKey.length > 0;
const linkedin = socialLinks.find((s) => s.icon === 'linkedin');
---

<BaseLayout searchable title="Collaborate" description="Join one of Daniel Khan's projects, start a public discussion, or get in touch privately.">
  <PageHeader title="Collaborate" lede="Join a project that's already moving, raise an idea in public, or get in touch privately. Corrections are as welcome as proposals." />

  <section class="section" aria-labelledby="join-title">
    <div class="container">
      <div class="section-title"><h2 id="join-title">Join a project</h2></div>
      <p class="section-intro">Say what you'd bring and suggest a small first step. The button opens a short form on GitHub.</p>
      <ul class="rows">
        {open.map((p) => (
          <li class="row">
            <div class="row-static join">
              <a class="row-title" href={`/work/${p.id}/`}>{p.data.title}</a>
              <span class="row-meta"><StatusBadge status={p.data.status} /></span>
              {p.data.collaboration?.needs.length ? <p class="row-text">Looking for: {p.data.collaboration.needs.join(', ')}</p> : null}
              <a class="btn btn-ghost join-btn" href={joinProjectUrl(githubCommunityUrl, p.data.title)}>Offer to help</a>
            </div>
          </li>
        ))}
      </ul>
      {projects.length > open.length && <p class="more">Other projects welcome good proposals too — see <a href="/work/">all projects</a>.</p>}
    </div>
  </section>

  <section class="section" aria-labelledby="contact-title">
    <div class="container contact">
      <div>
        <div class="section-title"><h2 id="contact-title">Get in touch</h2></div>
        <ul class="routes">
          {email && <li><strong>Email</strong><a href={`mailto:${email}`}>{email}</a></li>}
          {linkedin && <li><strong>Private message</strong><a href={linkedin.url} rel="noopener">Message me on LinkedIn</a></li>}
          {githubCommunityUrl && <li><strong>Public discussion</strong><a href={`${githubCommunityUrl}/discussions`}>Ideas, questions and resources on GitHub</a></li>}
        </ul>
        <p class="caution">Please don't send passwords, confidential documents or information about research participants. For sensitive material, ask first and we'll agree a secure route.</p>
        <div class="elsewhere"><SocialLinks variant="list" /></div>
      </div>
      {hasForm && (
        <div>
        <form class="message-form" method="POST" action="https://api.web3forms.com/submit">
          <input type="hidden" name="access_key" value={web3formsAccessKey} />
          <input type="hidden" name="subject" value={`New message from ${SITE.name}'s website`} />
          <input type="hidden" name="from_name" value={`${SITE.name} website`} />
          <input type="hidden" name="redirect" value={new URL('/collaborate/thanks/', Astro.site).href} />
          <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="field">
            <label for="f-name">Your name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="120" />
          </div>
          <div class="field">
            <label for="f-email">Your email</label>
            <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="254" />
            <span class="hint">Only used to reply to you.</span>
          </div>
          <div class="field">
            <label for="f-topic">What is it about?</label>
            <select id="f-topic" name="topic">
              <option>A collaboration idea</option>
              {projects.map((p) => <option>Joining: {p.data.title}</option>)}
              <option>A correction or source</option>
              <option>Media or speaking request</option>
              <option>Something else</option>
            </select>
          </div>
          <div class="field">
            <label for="f-message">Message</label>
            <textarea id="f-message" name="message" required maxlength="5000" rows="7"></textarea>
          </div>
          <label class="consent"><input type="checkbox" name="consent" value="yes" required /> I agree that this message is delivered through Web3Forms, a third-party form service, so Daniel can reply.</label>
          <button class="btn btn-primary" type="submit">Send message</button>
        </form>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .join { grid-template-columns: minmax(0, 1fr) auto; }
  .row-title { text-decoration: none; }
  .row-title:hover { color: var(--sea); text-decoration: underline; }
  .join-btn { grid-column: 1; justify-self: start; margin-top: 0.5rem; }
  .more { margin-top: 1.25rem; color: var(--ink-soft); }
  .more a { color: var(--sea); }

  .contact { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .contact:has(> :only-child) { grid-template-columns: minmax(0, 1fr); }
  .routes { list-style: none; padding: 0; border-top: 1px solid var(--line); max-width: 40rem; }
  .routes li { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: 0.25rem 1.5rem; padding-block: 0.9rem; border-bottom: 1px solid var(--line); }
  .routes a { color: var(--sea); font-weight: 600; }
  .caution { margin-top: 1.25rem; color: var(--ink-faint); font-size: var(--text-sm); max-width: 40rem; }
  .elsewhere { margin-top: 1.5rem; }
  .message-form { display: grid; gap: 1rem; padding: clamp(1.25rem, 3vw, 1.75rem); border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .consent { display: flex; gap: 0.6rem; align-items: start; font-size: 0.9rem; color: var(--ink-soft); }
  .consent input { margin-top: 0.3rem; accent-color: var(--sea); }
  .message-form .btn { justify-self: start; }
  @media (max-width: 52rem) { .contact { grid-template-columns: 1fr; } }
  @media (max-width: 34rem) { .routes li { grid-template-columns: 1fr; } }
</style>

<script>
  // Send the form in the background when JavaScript is available; otherwise it posts normally.
  const form = document.querySelector<HTMLFormElement>('.message-form');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    let note = form.querySelector<HTMLParagraphElement>('.form-note');
    if (!note) {
      note = document.createElement('p');
      note.className = 'form-note';
      note.setAttribute('role', 'status');
      form.append(note);
    }
    if (button) { button.disabled = true; button.textContent = 'Sending…'; }
    try {
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || result.success === false) throw new Error(result.message || `Error ${response.status}`);
      form.reset();
      note.textContent = 'Message sent. Thank you — I will reply by email.';
    } catch (error) {
      note.textContent = `Your message was not sent (${(error as Error).message}). Please try again, or use a public discussion instead.`;
    } finally {
      if (button) { button.disabled = false; button.textContent = 'Send message'; }
    }
  });
</script>
