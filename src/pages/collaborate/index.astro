---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import StatusBadge from '../../components/StatusBadge.astro';
import headshot from '../../assets/daniel-khan-headshot.jpg';
import { getWork, joinProjectUrl } from '../../lib/content';
import { SITE, githubCommunityUrl, socialLinks } from '../../site.config';

const work = await getWork();
const open = work.filter((w) => w.data.collaboration?.open);
const projects = work.filter((w) => w.data.type === 'project' || w.data.type === 'research' || w.data.type === 'media');
const { email, web3formsAccessKey } = SITE.contact;
const hasForm = web3formsAccessKey.length > 0;
const linkedin = socialLinks.find((s) => s.label === 'LinkedIn');
---

<BaseLayout searchable title="Collaborate" description="Join one of Daniel Khan's projects, start a public discussion, or send a private message.">
  <header class="page-head wrap">
    <p class="eyebrow">Collaborate</p>
    <h1 class="display">Let's build on this together.</h1>
    <p class="lede">Add your skills to a project that's already moving, propose an idea in public, or get in touch privately. Corrections are as welcome as pitches.</p>
  </header>

  <section class="section wrap" aria-labelledby="routes-title">
    <h2 id="routes-title" class="visually-hidden">Three ways to get involved</h2>
    <div class="routes">
      <article class="route">
        <p class="route-kicker mono">Join a project</p>
        <h3>Add to work in progress</h3>
        <p>Pick a project below and tell me what you'd contribute. It opens a short form on GitHub, so the conversation stays organised and visible.</p>
        <a class="text-link" href="#projects">See open projects <span aria-hidden="true">↓</span></a>
      </article>
      <article class="route">
        <p class="route-kicker mono">Talk in public</p>
        <h3>Ideas, questions and resources</h3>
        <p>Suggest a direction, ask about a tool, or share something useful in the community discussions. Anyone can read and reply.</p>
        {githubCommunityUrl
          ? <a class="text-link" href={`${githubCommunityUrl}/discussions`}>Open discussions <span aria-hidden="true">↗</span></a>
          : <span class="muted">Opening soon.</span>}
      </article>
      <article class="route">
        <p class="route-kicker mono">Write privately</p>
        <h3>A message just to me</h3>
        <p>For partnerships, commissions, media requests or anything you'd rather not post publicly.</p>
        <a class="text-link" href="#message">Send a message <span aria-hidden="true">↓</span></a>
      </article>
    </div>
  </section>

  <section class="section wrap" id="projects" aria-labelledby="projects-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">Join a project</p>
        <h2 id="projects-title" class="display">Projects you can join</h2>
        <p>{open.length > 0 ? 'These projects are actively looking for help. Others welcome good proposals too.' : 'Every project welcomes a well-made proposal.'}</p>
      </div>
    </div>
    <ul class="project-list">
      {(open.length > 0 ? [...open, ...projects.filter((p) => !open.includes(p))] : projects).map((p) => (
        <li class:list={['project', { 'is-open': p.data.collaboration?.open }]}>
          <div class="project-main">
            <div class="project-top">
              <a class="project-title" href={`/work/${p.id}/`}>{p.data.title}</a>
              <StatusBadge status={p.data.status} />
            </div>
            <p>{p.data.summary}</p>
            {p.data.collaboration?.open && p.data.collaboration.needs.length > 0 && (
              <p class="needs"><span class="mono">Looking for</span> {p.data.collaboration.needs.join(' · ')}</p>
            )}
          </div>
          <a class="btn btn-ghost" href={joinProjectUrl(githubCommunityUrl, p.data.title)}>Offer to help <span aria-hidden="true">↗</span></a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section wrap proposal" aria-labelledby="proposal-title">
    <div>
      <p class="eyebrow">Before you write</p>
      <h2 id="proposal-title" class="display">A good proposal fits in three steps.</h2>
    </div>
    <ol class="steps">
      <li><p><strong>Name the problem.</strong> What question, gap or bug would we work on?</p></li>
      <li><p><strong>Say what you'd bring.</strong> Skills, sources, code, time — and what is still uncertain.</p></li>
      <li><p><strong>Suggest a small first step.</strong> Something we could finish and check within a few weeks.</p></li>
    </ol>
  </section>

  <section class="section wrap message" id="message" aria-labelledby="message-title">
    <div class="message-intro">
      <p class="eyebrow">Write privately</p>
      <div class="message-who">
        <Picture src={headshot} formats={['avif', 'webp']} widths={[80, 160]} sizes="80px" alt="Daniel Khan" class="avatar" />
        <h2 id="message-title" class="display">Send a message</h2>
      </div>
      <p class="message-note">Messages come straight to me.</p>
      <p>Please don't send passwords, confidential documents or information about research participants. For sensitive material, ask first and we'll agree a secure route.</p>
      {(email || linkedin) && (
        <ul class="direct">
          {email && <li><span class="mono">Email</span> <a href={`mailto:${email}`}>{email}</a></li>}
          {linkedin && <li><span class="mono">LinkedIn</span> <a href={linkedin.url} rel="noopener">Message me on LinkedIn</a></li>}
        </ul>
      )}
    </div>

    {hasForm ? (
      <form class="message-form" method="POST" action="https://api.web3forms.com/submit">
        <input type="hidden" name="access_key" value={web3formsAccessKey} />
        <input type="hidden" name="subject" value={`New message from ${SITE.name}'s website`} />
        <input type="hidden" name="from_name" value={`${SITE.name} website`} />
        <input type="hidden" name="redirect" value={new URL('/collaborate/thanks/', Astro.site).href} />
        <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="field">
          <label for="f-name">Your name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="120" />
        </div>
        <div class="field">
          <label for="f-email">Your email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="254" />
          <span class="hint">Only used to reply to you.</span>
        </div>
        <div class="field">
          <label for="f-topic">What is it about?</label>
          <select id="f-topic" name="topic">
            <option>A collaboration idea</option>
            {projects.map((p) => <option>Joining: {p.data.title}</option>)}
            <option>A correction or source</option>
            <option>Media or speaking request</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="field">
          <label for="f-message">Message</label>
          <textarea id="f-message" name="message" required maxlength="5000" rows="7"></textarea>
        </div>
        <label class="consent"><input type="checkbox" name="consent" value="yes" required /> I agree that this message is delivered through Web3Forms, a third-party form service, so Daniel can reply.</label>
        <button class="btn btn-primary" type="submit">Send message</button>
      </form>
    ) : (
      <div class="message-fallback">
        <p class="fallback-title">The private form isn't switched on yet.</p>
        <p>Until it is, start a <a href={githubCommunityUrl ? `${githubCommunityUrl}/discussions` : '/collaborate/'}>public discussion</a> with a one-line hello and ask for a private channel — I'll reply there with one.</p>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .routes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: 1.25rem; }
  .route { padding: 1.6rem; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); display: grid; gap: 0.75rem; align-content: start; }
  .route-kicker { text-transform: uppercase; letter-spacing: 0.1em; color: var(--sea); }
  .route h3 { font-size: var(--step-2); font-stretch: 85%; }
  .route p:not(.route-kicker) { color: var(--ink-soft); font-family: var(--font-serif); }
  .route .text-link { justify-self: start; margin-top: 0.5rem; }
  .muted { color: var(--ink-faint); }

  .project-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .project { display: flex; gap: 1.5rem; align-items: center; justify-content: space-between; padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .project.is-open { background: linear-gradient(90deg, var(--sea-wash), transparent 70%); padding-inline: 1rem; border-radius: var(--radius-sm); }
  .project-main { display: grid; gap: 0.5rem; max-width: 46rem; }
  .project-top { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; }
  .project-title { font-size: var(--step-2); font-weight: 650; font-stretch: 85%; text-decoration: none; letter-spacing: -0.02em; }
  .project-title:hover { color: var(--sea); }
  .project p { color: var(--ink-soft); font-family: var(--font-serif); }
  .needs .mono { color: var(--sea); text-transform: uppercase; margin-right: 0.4rem; }
  @media (max-width: 44rem) { .project { flex-direction: column; align-items: start; } }

  .proposal { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 5rem); }
  .proposal h2 { font-size: var(--step-3); margin-top: 0.75rem; }
  .steps { margin: 0; padding: 0; list-style: none; counter-reset: step; display: grid; gap: 1.25rem; }
  .steps li { counter-increment: step; display: grid; grid-template-columns: 3rem 1fr; font-family: var(--font-serif); font-size: 1.15rem; color: var(--ink-soft); }
  .steps li::before { content: counter(step, decimal-leading-zero); font-family: var(--font-mono); color: var(--shingle); font-size: 0.95rem; padding-top: 0.2rem; }
  .steps strong { color: var(--ink); font-family: var(--font-display); }
  @media (max-width: 52rem) { .proposal { grid-template-columns: 1fr; } }

  .message { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .message-who { display: flex; align-items: center; gap: 1rem; margin-block: 1rem; }
  .message-who :global(.avatar) { width: 4rem; height: 4rem; border-radius: 50%; object-fit: cover; flex: none; }
  .message-intro h2 { font-size: var(--step-3); }
  .message-intro .message-note { font-family: var(--font-display); color: var(--ink); font-weight: 550; margin-bottom: 0.75rem; }
  .message-intro > p:not(.eyebrow) { color: var(--ink-soft); font-family: var(--font-serif); }
  .direct { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 0.5rem; }
  .direct .mono { display: inline-block; width: 6rem; color: var(--ink-faint); text-transform: uppercase; }
  .direct a { color: var(--sea); }
  .message-form, .message-fallback { display: grid; gap: 1.1rem; padding: clamp(1.25rem, 3vw, 2rem); border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .consent { display: flex; gap: 0.6rem; align-items: start; font-size: 0.9rem; color: var(--ink-soft); }
  .consent input { margin-top: 0.3rem; accent-color: var(--sea); }
  .message-form .btn { justify-self: start; }
  .fallback-title { font-weight: 650; font-size: var(--step-1); }
  .message-fallback p { color: var(--ink-soft); }
  .message-fallback a { color: var(--sea); }
  @media (max-width: 52rem) { .message { grid-template-columns: 1fr; } }
</style>

<script>
  // Send the form in the background when JavaScript is available; otherwise it posts normally.
  const form = document.querySelector<HTMLFormElement>('.message-form');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    let note = form.querySelector<HTMLParagraphElement>('.form-note');
    if (!note) {
      note = document.createElement('p');
      note.className = 'form-note';
      note.setAttribute('role', 'status');
      form.append(note);
    }
    if (button) { button.disabled = true; button.textContent = 'Sending…'; }
    try {
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || result.success === false) throw new Error(result.message || `Error ${response.status}`);
      form.reset();
      note.textContent = 'Message sent. Thank you — I will reply by email.';
    } catch (error) {
      note.textContent = `Your message was not sent (${(error as Error).message}). Please try again, or use a public discussion instead.`;
    } finally {
      if (button) { button.disabled = false; button.textContent = 'Send message'; }
    }
  });
</script>
