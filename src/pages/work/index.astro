---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import WorkRow from '../../components/WorkRow.astro';
import { getWork } from '../../lib/content';

const work = await getWork();
---

<BaseLayout title="Projects" description="Independent projects by Daniel Khan in journalism, documentary and open tools, each with its current status.">
  <PageHeader title="Projects" lede="Independent work in journalism, documentary and tools. Each project shows where it stands." />
  <section class="section">
    <div class="container">
      {work.length > 0
        ? <ul class="rows">{work.map((entry) => <WorkRow entry={entry} headingLevel="h2" />)}</ul>
        : <p>New projects are on their way.</p>}
    </div>
  </section>
</BaseLayout>
