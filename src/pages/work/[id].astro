---
import { render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getWork, WORK_TYPES, readingMinutes, isExternal, joinProjectUrl } from '../../lib/content';
import { githubCommunityUrl } from '../../site.config';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const collab = data.collaboration?.open ? data.collaboration : undefined;
---

<EntryLayout
  title={data.title}
  summary={data.summary}
  section={{ label: 'Projects', href: '/work/' }}
  kicker={WORK_TYPES[data.type]}
  date={data.date}
  updated={data.updated}
  status={data.status}
  tags={data.tags}
  minutes={data.type === 'writing' ? readingMinutes(entry.body) : undefined}
  cover={data.cover}
  coverAlt={data.coverAlt}
  draft={data.draft}
  ogType={data.type === 'writing' ? 'article' : 'website'}
>
  <Content />

  <Fragment slot="actions">
    {collab && (
      <div class="collab">
        <p><strong>Open for collaborators.</strong>{collab.needs.length > 0 && ' Looking for:'}</p>
        {collab.needs.length > 0 && <ul class="tags needs" aria-label="Looking for">{collab.needs.map((n) => <li>{n}</li>)}</ul>}
        <a class="btn btn-primary" href={joinProjectUrl(githubCommunityUrl, data.title)}>Offer to help</a>
      </div>
    )}
    {data.links.length > 0 && (
      <div class="links">
        {data.links.map((l) => (
          <a class="btn btn-ghost" href={l.url} rel={isExternal(l.url) ? 'noopener' : undefined}>{l.label} <span aria-hidden="true">{isExternal(l.url) ? '↗' : '→'}</span></a>
        ))}
      </div>
    )}
  </Fragment>
</EntryLayout>

<style>
  .collab { display: grid; gap: 0.9rem; justify-items: start; padding: 1.1rem 1.25rem; border-radius: var(--radius); background: var(--sea-wash); }
  .links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .needs li { border-color: color-mix(in srgb, var(--sea) 30%, var(--line)); background: var(--surface); color: var(--ink); }
</style>
