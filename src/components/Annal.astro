---
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate } from '../lib/content';

interface Props { entries: CollectionEntry<'log'>[]; headingLevel?: 'h2' | 'h3' }
const { entries, headingLevel: Heading = 'h2' } = Astro.props;
---

<ol class="rows">
  {entries.map((entry) => (
    <li class="row">
      <a class="row-link" href={`/log/${entry.id}/`}>
        <Heading class="row-title">{entry.data.title}{entry.data.draft && ' (draft)'}</Heading>
        <time class="row-meta date" datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
        <p class="row-text">{entry.data.summary}</p>
      </a>
    </li>
  ))}
</ol>

<style>
  .date { font-size: var(--text-sm); color: var(--ink-faint); font-variant-numeric: tabular-nums; white-space: nowrap; padding-top: 0.2rem; }
</style>
