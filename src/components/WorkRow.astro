---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';

interface Props { entry: CollectionEntry<'work'>; headingLevel?: 'h2' | 'h3' }
const { entry, headingLevel: Heading = 'h3' } = Astro.props;
const { data } = entry;
---

<li class="row">
  <a class="row-link" href={`/work/${entry.id}/`}>
    <Heading class="row-title">{data.title}{data.draft && ' (draft)'}</Heading>
    <span class="row-meta"><StatusBadge status={data.status} /></span>
    <p class="row-text">{data.summary}</p>
  </a>
</li>
