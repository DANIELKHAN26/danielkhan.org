---
import Icon from './Icon.astro';
import { SITE, socialLinks } from '../site.config';

interface Props {
  /** 'chips' = icon + name in one tidy row; 'icons' = compact round buttons (footer). */
  variant?: 'chips' | 'icons';
  /** Add the public email as the first item. */
  withEmail?: boolean;
  label?: string;
}
const { variant = 'chips', withEmail = false, label = 'Daniel Khan elsewhere' } = Astro.props;
const email = withEmail ? SITE.contact.email : '';
---

{(socialLinks.length > 0 || email) && (
  <ul class:list={['social', `social-${variant}`]} aria-label={label}>
    {email && (
      <li>
        <a href={`mailto:${email}`} title={variant === 'icons' ? email : undefined}>
          <svg class="icon-mail" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.4" d="M1.5 3.5h13v9h-13zM1.8 3.8 8 8.6l6.2-4.8" /></svg>
          <span class={variant === 'icons' ? 'visually-hidden' : undefined}>Email</span>
        </a>
      </li>
    )}
    {socialLinks.map((s) => (
      <li>
        <a href={s.url} rel="me noopener" title={variant === 'icons' ? s.label : undefined}>
          <Icon name={s.icon} size={16} />
          <span class={variant === 'icons' ? 'visually-hidden' : undefined}>{s.label}</span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .social { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .social a { color: var(--ink); text-decoration: none; transition: border-color .2s; }
  .social-chips a {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.5rem; padding: 0.4rem 0.9rem 0.4rem 0.75rem;
    border: 1px solid var(--line); border-radius: 999px; background: var(--surface); font-weight: 600; font-size: 0.9rem;
  }
  .social-icons a { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 1px solid var(--line); background: var(--surface); }
  .social a:hover { border-color: var(--sea); }
  .icon-mail { color: var(--sea); }
</style>
