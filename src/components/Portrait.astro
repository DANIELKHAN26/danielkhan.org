---
import { Picture } from 'astro:assets';
import photo from '../assets/daniel-khan-profile.jpg';

interface Props { size?: 'large' | 'small'; eager?: boolean }
const { size = 'large', eager = false } = Astro.props;
---

<div class:list={['portrait', `portrait-${size}`]}>
  {size === 'large' && (
    <svg class="portrait-lines" viewBox="0 0 400 400" aria-hidden="true">
      <circle cx="200" cy="200" r="171" fill="none" class="l-base" />
      <path d="M200.0 16.0 A184 184 0 0 1 372.9 137.1" fill="none" class="l-sea" />
      <circle cx="372.9" cy="137.1" r="5" class="d-sea" />
      <path d="M40.7 292.0 A184 184 0 0 1 18.8 232.0" fill="none" class="l-warm" />
      <path d="M267.0 384.2 A196 196 0 0 0 338.6 338.6" fill="none" class="l-faint" />
    </svg>
  )}
  <Picture
    src={photo}
    formats={['avif', 'webp']}
    widths={size === 'large' ? [320, 480, 640, 880] : [96, 192, 288]}
    sizes={size === 'large' ? '(min-width: 56rem) 20rem, 15rem' : '6rem'}
    alt="Portrait of Daniel Khan"
    class="portrait-photo"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
</div>

<style>
  .portrait { position: relative; display: grid; place-items: center; aspect-ratio: 1; }
  .portrait-large { width: min(100%, 25rem); }
  .portrait-small { width: 6rem; }
  .portrait :global(.portrait-photo) {
    width: 85.5%; aspect-ratio: 1; object-fit: cover; border-radius: 50%;
    background: #fff; box-shadow: 0 0 0 1px var(--line), var(--shadow);
  }
  .portrait-small :global(.portrait-photo) { width: 100%; }
  .portrait-lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .l-base { stroke: var(--line); stroke-width: 1.5; }
  .l-sea { stroke: var(--sea); stroke-width: 3; stroke-linecap: round; }
  .d-sea { fill: var(--sea); }
  .l-warm { stroke: var(--shingle); stroke-width: 3; stroke-linecap: round; }
  .l-faint { stroke: var(--ink-faint); stroke-width: 1.5; stroke-linecap: round; opacity: 0.6; }
</style>
