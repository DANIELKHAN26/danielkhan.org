<style>
  .wave { width: 100%; height: auto; display: block; }
  .wave rect { transform-box: fill-box; transform-origin: center; }
  .wave-played rect { fill: var(--sea); }
  .wave-rest rect { fill: currentColor; opacity: 0.35; }
  @media (prefers-reduced-motion: no-preference) {
    .wave rect { animation: breathe 2.8s ease-in-out infinite; }
    .wave rect:nth-child(3n + 1) { animation-delay: -0.9s; }
    .wave rect:nth-child(3n + 2) { animation-delay: -1.8s; }
  }
  @keyframes breathe { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(0.72); } }
</style>
