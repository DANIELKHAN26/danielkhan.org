---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';
import { WORK_TYPES } from '../lib/content';

interface Props { entry: CollectionEntry<'work'>; headingLevel?: 'h2' | 'h3' }
const { entry, headingLevel: Heading = 'h3' } = Astro.props;
const { data } = entry;
---

<article class="tile">
  <div class="tile-meta">
    <span class="tile-kind">{WORK_TYPES[data.type]}</span>
    <StatusBadge status={data.status} />
  </div>
  <Heading class="tile-title"><a class="tile-link" href={`/work/${entry.id}/`}>{data.title}{data.draft && ' (draft)'}</a></Heading>
  <p class="tile-text">{data.summary}</p>
  <div class="tile-foot">
    {data.collaboration?.open ? <span class="open">Seeking collaborators</span> : <ul class="tile-chips">{data.tags.slice(0, 2).map((t) => <li>{t}</li>)}</ul>}
    <span class="tile-arrow" aria-hidden="true">→</span>
  </div>
</article>

<style>
  .open { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; color: var(--sea); }
  .open::before { content: ''; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--sea); box-shadow: 0 0 0 3px var(--sea-wash); }
</style>
