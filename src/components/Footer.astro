---
import Lockup from '../assets/brand/dk-lockup.svg';
import SocialLinks from './SocialLinks.astro';
import { SITE } from '../site.config';
const year = new Date().getFullYear();
const links = [
  { label: 'Research', href: '/research/' },
  { label: 'Projects', href: '/work/' },
  { label: 'Lab', href: '/lab/' },
  { label: 'Updates', href: '/updates/' },
  { label: 'Collaborate', href: '/collaborate/' },
  { label: 'About', href: '/about/' },
  { label: 'Search', href: '/search/' },
];
---

<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a href="/" aria-label="Daniel Khan, home"><Lockup class="footer-logo" aria-hidden="true" /></a>
      {SITE.contact.email && <a class="footer-email" href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>}
    </div>
    <SocialLinks variant="icons" />
  </div>
  <nav class="container footer-nav" aria-label="Footer">
    <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
  </nav>
  <div class="container footer-base">
    <span>© {year} {SITE.name}</span>
    <span><a href="/privacy/">Privacy</a> · <a href="/rss.xml">RSS</a></span>
  </div>
</footer>

<style>
  .site-footer { margin-top: auto; border-top: 1px solid var(--line); background: var(--surface); }
  .footer-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2rem; padding-block: 2rem 1.25rem; }
  .footer-brand { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  .footer-brand :global(.footer-logo) { display: block; width: 8.5rem; height: auto; color: var(--ink); }
  .footer-email { color: var(--sea); font-weight: 600; }
  .footer-email:hover { color: var(--sea-strong); }
  .footer-nav ul { list-style: none; padding: 0 0 1.25rem; display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; }
  .footer-nav a { display: inline-block; padding-block: 0.25rem; color: var(--ink-soft); text-decoration: none; }
  .footer-nav a:hover { color: var(--sea); text-decoration: underline; }
  .footer-base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem; padding-block: 1rem 1.5rem; border-top: 1px solid var(--line); font-size: var(--text-sm); color: var(--ink-faint); }
  .footer-base a { color: inherit; }
</style>
