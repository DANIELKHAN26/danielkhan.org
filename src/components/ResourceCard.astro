---
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'workshop'>; headingLevel?: 'h2' | 'h3' }
const { entry, headingLevel: Heading = 'h3' } = Astro.props;
const { data } = entry;
---

<article class="card">
  <span class="card-kind">Free {data.kind.toLowerCase()}</span>
  <Heading><a href={`/workshop/${entry.id}/`}>{data.title}{data.draft && ' (draft)'}</a></Heading>
  <p>{data.summary}</p>
  <div class="card-facts">
    <span>Version {data.version}</span>
    <span>{data.licence}</span>
  </div>
</article>
